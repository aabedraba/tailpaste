<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.abdallah.tailpaste</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tailpaste</string>
        <string>daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- pbcopy/pbpaste live in /usr/bin; launchd's default PATH is minimal. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/tailpaste.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/tailpaste.log</string>
</dict>
</plist>
